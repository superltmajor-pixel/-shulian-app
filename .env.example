# API Key 不再写入 .env；请在数恋启动后的“连接 DeepSeek”界面中输入。
DEEPSEEK_BASE_URL=https://api.deepseek.com
SHULIAN_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30

# Keep empty for the bundled same-origin web app.
# For a separate trusted frontend, use a comma-separated allowlist.
CORS_ORIGINS=
MAX_REQUEST_BYTES=131072
MAX_CHAT_REQUEST_BYTES=10485760
MAX_VOICE_BYTES=4194304

# TTS provider: edge | gpt_sovits
TTS_PROVIDER=edge
# 正式版可使用独立变量覆盖通用设置，避免与纯净版互相污染。
# SHULIAN_FORMAL_TTS_PROVIDER=gpt_sovits
# SHULIAN_FORMAL_EDGE_TTS_CHARACTER_CONFIG={"custom_example":{"voice":"zh-CN-XiaoyiNeural","rate":"-4%","pitch":"+8Hz"}}

# GPT-SoVITS service settings. Keep default "/tts" for api_v2.py.
# For legacy api.py deployments, set GPT_SOVITS_ENDPOINT=/
GPT_SOVITS_BASE_URL=
GPT_SOVITS_ENDPOINT=/tts
GPT_SOVITS_TIMEOUT_SECONDS=45

# Example:
# GPT_SOVITS_CHARACTER_CONFIG={"custom_example":{"ref_audio_path":"C:/voices/custom_example_ref.wav","prompt_text":"你好，很高兴认识你。","prompt_lang":"zh","text_lang":"zh"}}
GPT_SOVITS_CHARACTER_CONFIG=
# SHULIAN_FORMAL_GPT_SOVITS_BASE_URL=http://127.0.0.1:9880
# SHULIAN_FORMAL_GPT_SOVITS_ENDPOINT=/tts
# SHULIAN_FORMAL_GPT_SOVITS_CHARACTER_CONFIG={}
